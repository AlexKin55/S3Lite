# S3Lite agent configuration (systemd EnvironmentFile, read on service start).
# Set CONTROL_PLANE to the control plane address, then:
#   systemctl start s3lite-agent
#
# Control plane (required): https://<CONTROL_PLANE_ADDR>:8099
CONTROL_PLANE=https://CHANGE_ME:8099

# Path to the SeaweedFS binary bundled with this package.
WEED_BIN=/usr/bin/weed
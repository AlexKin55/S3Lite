# S3Lite control plane configuration (systemd EnvironmentFile, read on service start).
# After editing run: systemctl restart s3lite-server
#
# Listen address (host:port). Empty host = all interfaces.
LISTEN=:8099

# SeaweedFS master HTTP address.
MASTER=127.0.0.1:9333

# Optional TLS: paths to a PEM certificate and key (generate with deploy/tls/generate.sh).
# Empty values = plain HTTP.
#TLS_CERT=/etc/s3lite/tls/server.crt
#TLS_KEY=/etc/s3lite/tls/server.key

# Optional webhook URL for notifications. Empty = log only.
#WEBHOOK=https://alerts.example.com/hook
[Unit]
Description=S3Lite control plane server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=s3lite
Environment=LISTEN=:8099
Environment=MASTER=127.0.0.1:9333
Environment=TLS_CERT=
Environment=TLS_KEY=
Environment=WEBHOOK=
EnvironmentFile=-/etc/s3lite/server.env
ExecStart=/usr/bin/s3lite-server \
    -listen=${LISTEN} \
    -master=${MASTER} \
    -tlsCert=${TLS_CERT} \
    -tlsKey=${TLS_KEY} \
    -webhook=${WEBHOOK}
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

# Hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
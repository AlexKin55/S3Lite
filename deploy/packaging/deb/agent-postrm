#!/bin/sh
set -e

if [ "$1" = "purge" ]; then
  # Remove the service account and local data only on purge and only if the
  # control plane package that shares the account is not installed.
  if command -v dpkg >/dev/null 2>&1 && ! dpkg -l s3lite-server >/dev/null 2>&1; then
    if command -v userdel >/dev/null 2>&1; then
      userdel --system s3lite >/dev/null 2>&1 || true
    fi
  fi
  rm -rf /var/lib/s3lite/agent
  if [ -n "$(ls -A /var/lib/s3lite 2>/dev/null)" ]; then
    rmdir /var/lib/s3lite >/dev/null 2>&1 || true
  fi
  rm -f /etc/s3lite/agent.env
  rmdir /etc/s3lite >/dev/null 2>&1 || true
fi

exit 0
[Unit]
Description=S3Lite storage node agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=s3lite
# Re-create /var/lib/s3lite and the agent working directory with the right
# owner on every start (the + prefix runs this as root despite User=s3lite),
# so a missing or mis-owned parent can never crash-loop the agent.
ExecStartPre=+/usr/bin/install -d -o s3lite -g s3lite -m 0750 /var/lib/s3lite /var/lib/s3lite/agent
Environment=CONTROL_PLANE=https://CHANGE_ME:8099
Environment=WEED_BIN=/usr/bin/weed
# Storage this node contributes: data directory (must be writable by the
# s3lite user) and maximum size in megabytes.
Environment=STORAGE=/var/lib/s3lite/data
Environment=STORAGE_SIZE=100
EnvironmentFile=-/etc/s3lite/agent.env
ExecStart=/usr/bin/s3lite-agent \
    -dir=/var/lib/s3lite/agent \
    -server=${CONTROL_PLANE} \
    -weed=${WEED_BIN} \
    -storage=${STORAGE} \
    -capacity=${STORAGE_SIZE} \
    -insecure
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

# Hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
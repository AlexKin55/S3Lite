[Unit]
Description=S3Lite storage node agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=s3lite
Environment=CONTROL_PLANE=https://CHANGE_ME:8099
Environment=WEED_BIN=/usr/bin/weed
EnvironmentFile=-/etc/s3lite/agent.env
ExecStart=/usr/bin/s3lite-agent \
    -dir=/var/lib/s3lite/agent \
    -server=${CONTROL_PLANE} \
    -weed=${WEED_BIN} \
    -insecure
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

# Hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
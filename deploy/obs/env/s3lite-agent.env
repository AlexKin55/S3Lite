# s3lite-agent configuration (conffile, owned by the s3lite user)
# Control plane REST endpoint the agent registers with and reports to.
CONTROL_PLANE=https://CHANGE_ME:8099
# Path to the SeaweedFS binary (shipped by the s3lite-weed package).
WEED_BIN=/usr/bin/weed
# Directory where the agent stores its volume data. Create it as root and
# grant it to the s3lite user so the agent can read/write, e.g.:
#   sudo mkdir -p /var/lib/s3lite/data && sudo chown s3lite:s3lite /var/lib/s3lite/data
STORAGE=/var/lib/s3lite/data
# Maximum storage this node contributes to the cluster, in gigabytes.
# Must be >= the master's compiled-in volume size limit (500 MB, see
# weed/util/volume_size.go in the sources): a node with less than one
# volume cannot be given a correct volume slot count.
# in GB
STORAGE_SIZE=5
# Maximum storage this node contributes to the cluster, in gigabytes.
# Must be >= the master's compiled-in volume size limit (500 MB): a node with
# less than one volume cannot be given a correct volume slot count.
# in GB

# EC_SHARD_SLOT_RATIO: percent of volume slots reserved for erasure coding
# shards (the rest hold raw volume replicas). With STORAGE_SIZE=5 GB and a
# 500 MB volume cap there are 10 slots total; ratio=30 reserves 3 slots for
# 6+4 shards and 7 for raw replicas.
EC_SHARD_SLOT_RATIO=30

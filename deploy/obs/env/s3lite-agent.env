# s3lite-agent configuration (conffile, owned by the s3lite user)
# Control plane REST endpoint the agent registers with and reports to.
CONTROL_PLANE=https://CHANGE_ME:8099
# Path to the SeaweedFS binary (shipped by the s3lite-weed package).
WEED_BIN=/usr/bin/weed
# Directory where the agent stores its volume data. Create it as root and
# grant it to the s3lite user so the agent can read/write, e.g.:
#   sudo mkdir -p /var/lib/s3lite/data && sudo chown s3lite:s3lite /var/lib/s3lite/data
STORAGE=/var/lib/s3lite/data
# Maximum storage this node contributes to the cluster, in megabytes.
STORAGE_SIZE=100

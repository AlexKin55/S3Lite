# s3lite-server configuration (conffile, owned by the s3lite user)
# All static settings live here. agent.json / CLI flags cannot override them.

# Listen address of the control plane REST/UI endpoint.
LISTEN=:8099

# TLS: point at certificates installed under /etc/s3lite/tls/ (see deploy/tls).
#TLS_CERT=/etc/s3lite/tls/server.crt
#TLS_KEY=/etc/s3lite/tls/server.key

# SeaweedFS master address (or comma-separated Raft peers) to poll for topology.
# Accepts an IP or a DNS name (FQDN). The value is handed to every agent at
# registration, so it must be reachable from all nodes: use the master's
# FQDN, not 127.0.0.1 (loopback only works for a single-host test setup).
# For multi-master HA list all peers: master1.corp:9333,master2.corp:9333.
MASTER=127.0.0.1:9333

# SeaweedFS filer HTTP address (used to list existing S3 buckets).
FILER=127.0.0.1:8888

# Topology poll interval (seconds).
POLL_SEC=15

# Agent heartbeat TTL (seconds).
HEARTBEAT_TTL=60

# Cluster read-only threshold: S3 writes are refused while fewer volume
# servers are online than this. Keep it >= the EC scheme size (6+4 = 10).
# 0 disables the guard. Consumed by the control plane; s3proxy enforces it.
MIN_WRITE_NODES=10

# Optional webhook URL for cluster risk notifications.
#WEBHOOK_URL=https://alerts.example.com/hook

# Default replication for new volumes; consumed by s3lite-master. 020 = 3
# copies on 3 different racks (PCs) — fault tolerant from the first write;
# the EC worker replaces the raw replicas with 6+4 shards ~5 minutes after
# writes stop. Formats: 020 = 3 racks, 010 = 2 racks, 000 = 1 copy.
DEFAULT_REPLICATION=010

# Data center name for volume servers.
DATA_CENTER=dc1

# Rack name prefix.
RACK_BASE=rack

# Max volumes for volume servers.
MAX_VOLUMES=8

# EC_SHARD_SLOT_RATIO: percent of volume slots reserved for erasure coding
# shards (the rest hold raw volume replicas). With STORAGE_SIZE=5 GB and a
# 500 MB volume cap there are 10 slots total; ratio=30 reserves 3 slots for
# 6+4 shards and 7 for raw replicas. This is a planning hint — SeaweedFS
# decides the actual type per slot.
EC_SHARD_SLOT_RATIO=30

# Disk type for volume servers.
DISK_TYPE=hdd

# Starting port for agent volume servers.
PORT_BASE=8080

# JSON file persisting operator node flags (preferred replica targets) across restarts.
STATE_FILE=/var/lib/s3lite/server-state.json

# File where the preferred volume server address list ("ip:port" per line) is
# published for the master's -preferredNodesFile.
PREFERRED_NODES_FILE=/var/lib/s3lite/preferred-nodes.txt

# File with preferred node ids (one per line) that are always preferred and
# cannot be unmarked via the web UI.
PREFERRED_POLICY_FILE=/etc/s3lite/policy.conf

# Base URL of the SeaweedFS admin server (used to trigger immediate EC
# encoding via its plugin API).
ADMIN_URL=http://127.0.0.1:12535

# Path to the weed binary; the dashboard fsck button runs 'weed shell
# volume.fsck' with it.
WEED_BIN=/usr/bin/weed

# Wall-clock cap on a dashboard-triggered volume.fsck run (seconds).
FSCK_TIMEOUT=600

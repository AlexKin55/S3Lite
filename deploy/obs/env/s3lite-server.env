# s3lite-server configuration (conffile, owned by the s3lite user)
# Listen address of the control plane REST/UI endpoint.
LISTEN=:8099
# SeaweedFS master address (or comma-separated Raft peers) to poll for topology.
# The package ships s3lite-master.service on port 9333. For agents on other
# PCs to find this master, set MASTER to this host's LAN IP (127.0.0.1 only
# works for the local monitor).
MASTER=127.0.0.1:9333
# TLS: point at certificates installed under /etc/s3lite/tls/ (see deploy/tls).
#TLS_CERT=/etc/s3lite/tls/server.crt
#TLS_KEY=/etc/s3lite/tls/server.key
# Optional webhook URL for cluster risk notifications.
#WEBHOOK=https://alerts.example.com/hook

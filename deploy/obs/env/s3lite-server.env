# s3lite-server configuration (conffile, owned by the s3lite user)
# Listen address of the control plane REST/UI endpoint.
LISTEN=:8099
# Master volume size limit (MB). Maximum size of a single volume on each node.
# The agent derives max_volumes = STORAGE_SIZE / (volumeSizeLimitMB / 1024)
# so that max_volumes * volumeSizeLimitMB <= STORAGE_SIZE.
# Default 1 GB volumes.
VOLUME_SIZE_LIMIT_MB=1024
# SeaweedFS master address (or comma-separated Raft peers) to poll for topology.
# Accepts an IP or a DNS name (FQDN). The value is handed to every agent at
# registration, so it must be reachable from all nodes: use the master's
# FQDN, not 127.0.0.1 (loopback only works for a single-host test setup).
# For multi-master HA list all peers: master1.corp:9333,master2.corp:9333.
MASTER=127.0.0.1:9333
# TLS: point at certificates installed under /etc/s3lite/tls/ (see deploy/tls).
#TLS_CERT=/etc/s3lite/tls/server.crt
#TLS_KEY=/etc/s3lite/tls/server.key
# Optional webhook URL for cluster risk notifications.
#WEBHOOK=https://alerts.example.com/hook
# Cluster read-only threshold: S3 writes are refused while fewer volume
# servers are online than this. Keep it >= the EC scheme size (6+4 = 10).
# 0 disables the guard. Consumed by the control plane; s3proxy enforces it.
MIN_WRITE_NODES=10
# Default replication for new volumes; consumed by s3lite-master. 020 = 3
# copies on 3 different racks (PCs) — fault tolerant from the first write;
# the EC worker replaces the raw replicas with 6+4 shards ~5 minutes after
# writes stop. Formats: 020 = 3 racks, 010 = 2 racks, 000 = 1 copy.
DEFAULT_REPLICATION=020

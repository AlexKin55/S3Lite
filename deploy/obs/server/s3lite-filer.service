[Unit]
Description=S3Lite SeaweedFS filer
After=network-online.target s3lite-master.service
Wants=network-online.target s3lite-master.service

# The filer owns the file-name -> volume mapping (filer store in
# /var/lib/s3lite/filer) and is the backend of the S3 gateway.
#
# The default replication of NEW volumes (before the EC worker converts them
# to 6+4) is NOT set here: with -defaultReplicaPlacement empty the filer asks
# the master for its setting, so -defaultReplication from s3lite-master
# (VOLUME_SIZE_LIMIT_MB / DEFAULT_REPLICATION in /etc/s3lite/server.env) is
# the single source of truth. An explicit "000" here would silently override
# the master and create single-copy volumes that all land on one node.

[Service]
Type=simple
User=s3lite
ExecStart=/usr/bin/weed filer \
    -port=8888 \
    -master=127.0.0.1:9333 \
    -defaultStoreDir=/var/lib/s3lite/filer
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

# Hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

[Unit]
Description=S3Lite control plane server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=s3lite
EnvironmentFile=-/etc/s3lite/server.env
ExecStart=/usr/bin/s3lite-server
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

# Hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

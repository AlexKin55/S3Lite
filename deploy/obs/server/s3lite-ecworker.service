[Unit]
Description=S3Lite maintenance worker (automatic erasure coding 6+4)
After=network-online.target s3lite-admin.service
Requires=s3lite-admin.service

# Scans the cluster for erasure-coding candidates and encodes quiet volumes
# into EC 6+4 (10 shards spread across 10 different nodes; the data survives
# the loss of up to 4 nodes), then deletes the raw source replicas. The scan
# interval and thresholds come from the declarative policy in
# /etc/s3lite/admin.toml (see s3lite-admin.service); the shard ratio 6+4 is
# the compiled-in default of this fork.

[Service]
Type=simple
User=s3lite
ExecStart=/usr/bin/weed worker \
    -admin=127.0.0.1:12535 \
    -jobType=erasure_coding \
    -workingDir=/var/lib/s3lite/worker
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

# Hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

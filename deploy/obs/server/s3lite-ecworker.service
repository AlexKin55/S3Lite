[Unit]
Description=S3Lite maintenance worker (automatic erasure coding 6+4)
After=network-online.target s3lite-admin.service
Requires=s3lite-admin.service

# Scans the cluster every 30 minutes and erasure-codes full, quiet volumes
# into EC 6+4 (10 shards spread across 10 different nodes; the data survives
# the loss of up to 4 nodes). The shard ratio and thresholds are configured
# in the admin UI on 127.0.0.1:12535.

[Service]
Type=simple
User=s3lite
ExecStart=/usr/bin/weed worker \
    -admin=127.0.0.1:12535 \
    -jobType=erasure_coding \
    -workingDir=/var/lib/s3lite/worker
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

# Hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

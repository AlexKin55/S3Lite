[Unit]
Description=S3Lite SeaweedFS master
After=network-online.target
Wants=network-online.target

# The master needs no configuration: the weed binary (shipped by the shared
# s3lite-weed package, which s3lite-server Requires) auto-detects the first
# non-loopback IPv4 address and advertises it to the cluster, while
# -ip.bind=0.0.0.0 makes it listen on all interfaces. The control plane
# (s3lite-server) and the node agents reach it via the MASTER variable in
# /etc/s3lite/server.env.

[Service]
Type=simple
User=s3lite
EnvironmentFile=-/etc/s3lite/server.env
# Volume size limit (MB) per volume. Together with the per-node -max handed
# out by the control plane it caps the RAW (pre-EC) buffer a node can hold:
# volumes are written 3x-replicated, erasure-coded by the maintenance worker
# ~5 minutes after writes stop, and the raw replicas are then deleted.
# 500 MB keeps shards (~85 MB data each) small and lets even lone small
# files reach every node within minutes.
# The value lives in /etc/s3lite/server.env (VOLUME_SIZE_LIMIT_MB, default
# 500, uncommented) — the single place to change it; EnvironmentFile values
# override the fallback below, which only covers old server.env copies where
# the variable is still commented out.
Environment=VOLUME_SIZE_LIMIT_MB=500
# Default replication for new volumes: 3 copies on 3 different racks (each
# node is its own rack, so on 3 different PCs). Every write is fault tolerant
# from the first second; the EC worker later replaces the replicas with 6+4
# shards that survive the loss of up to 4 nodes.
# Like VOLUME_SIZE_LIMIT_MB, the value lives in /etc/s3lite/server.env
# (DEFAULT_REPLICATION, default 020, uncommented); the line below is only a
# fallback for old server.env copies where the variable is commented out.
Environment=DEFAULT_REPLICATION=020
# -preferredNodesFile is written by the control plane (s3lite-server) from
# the "preferred node" toggles in its dashboard; the master re-reads it
# periodically, so toggles apply without a master restart.
ExecStart=/usr/bin/weed master \
    -port=9333 \
    -mdir=/var/lib/s3lite/master \
    -ip.bind=0.0.0.0 \
    -volumeSizeLimitMB=${VOLUME_SIZE_LIMIT_MB} \
    -defaultReplication=${DEFAULT_REPLICATION} \
    -preferredNodesFile=/var/lib/s3lite/preferred-nodes.txt
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

# Hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
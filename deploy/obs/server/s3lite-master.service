[Unit]
Description=S3Lite SeaweedFS master
After=network-online.target
Wants=network-online.target

# The master needs no configuration: the weed binary (shipped by the shared
# s3lite-weed package, which s3lite-server Requires) auto-detects the first
# non-loopback IPv4 address and advertises it to the cluster, while
# -ip.bind=0.0.0.0 makes it listen on all interfaces. The control plane
# (s3lite-server) and the node agents reach it via the MASTER variable in
# /etc/s3lite/server.env.

[Service]
Type=simple
User=s3lite
EnvironmentFile=-/etc/s3lite/server.env
# The volume size limit per volume (500 MB) is NOT configurable here: it is
# the compiled-in weed default (util.DefaultVolumeSizeLimitMB in
# src/thirdparty/seaweedfs/weed/util/volume_size.go). Together with the
# per-node -max handed out by the control plane it caps the RAW (pre-EC)
# buffer a node can hold: volumes are written 3x-replicated, erasure-coded
# by the maintenance worker ~5 minutes after writes stop, and the raw
# replicas are then deleted. Changing the limit requires recompiling weed
# (and reviewing the agents' STORAGE_SIZE quotas) — a conscious choice.
#
# Default replication for new volumes: 3 copies on 3 different racks (each
# node is its own rack, so on 3 different PCs). Every write is fault tolerant
# from the first second; the EC worker later replaces the replicas with 6+4
# shards that survive the loss of up to 4 nodes.
#
# The value comes from /etc/s3lite/server.env (DEFAULT_REPLICATION=020,
# uncommented). If the variable is missing, the master gets an empty
# -defaultReplication= and starts with single-copy volumes — check server.env
# first when the dashboard shows unreplicated data.
# -preferredNodesFile is written by the control plane (s3lite-server) from
# the "preferred node" toggles in its dashboard; the master re-reads it
# periodically, so toggles apply without a master restart.
ExecStart=/usr/bin/weed master \
    -port=9333 \
    -mdir=/var/lib/s3lite/master \
    -ip.bind=0.0.0.0 \
    -defaultReplication=${DEFAULT_REPLICATION} \
    -preferredNodesFile=/var/lib/s3lite/preferred-nodes.txt
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

# Hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target